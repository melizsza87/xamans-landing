# cantalove.com — variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NINGUNA de estas keys debe tener el prefijo NEXT_PUBLIC_ salvo las que
# están explícitamente marcadas como públicas: son las únicas que el
# navegador puede ver. Todo lo demás sólo se lee en las API routes del
# servidor (ver REGLA DE SEGURIDAD en el README).

# --- Claude (Anthropic) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional — modelo a usar en /api/generate-lyrics. Por defecto: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# --- Apiframe (Suno) ---
# https://apiframe.ai — panel de API keys. Se envía en el header X-API-Key.
APIFRAME_API_KEY=
# Opcional — sólo si Apiframe te asigna un base URL distinto
APIFRAME_API_BASE=https://api.apiframe.ai
# Opcional — versión del modelo Suno enviada en sunoParams.model_version
APIFRAME_MODEL_VERSION=v4_5plus

# --- Supabase ---
# Project Settings → API. La service_role key NUNCA debe usarse en el cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Públicas — usadas sólo si en el futuro agregas un cliente Supabase en el
# navegador (hoy el frontend no llama a Supabase directamente).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- MercadoPago ---
# Tus credenciales → Producción o Prueba, según el ambiente.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secreto de firma del webhook (Tus integraciones → tu app → Webhooks →
# "Firma secreta"). Necesario para verificar /api/mercadopago/webhook.
MP_WEBHOOK_SECRET=

# --- Resend ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en Resend, formato "Nombre <correo@dominio.com>"
RESEND_FROM_EMAIL=cantalove <hola@cantalove.com>

# --- Sitio ---
# URL pública del sitio en producción, usada para construir back_urls de
# MercadoPago, el notification_url del webhook y los links de los emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
